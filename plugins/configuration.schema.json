{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nons:plugin:configuration:1",
  "title": "Nons Plugin Configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "page", "fields"],
  "properties": {
    "version": {
      "const": 1
    },
    "page": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {
              "const": "generated"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "pageId"],
          "properties": {
            "mode": {
              "const": "custom"
            },
            "pageId": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "fields": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "title", "description", "schema", "default"],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "顶层配置键；点不表示嵌套路径。"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "description": {
            "type": "string",
            "maxLength": 2048
          },
          "schema": {
            "type": "object",
            "description": "JSON Schema 2020-12，只允许当前字段 schema 内部引用。"
          },
          "default": {},
          "apply": {
            "enum": ["live", "reload"],
            "default": "live"
          },
          "group": {
            "type": ["string", "null"]
          },
          "editor": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind"],
                "properties": {
                  "kind": {
                    "enum": [
                      "text",
                      "textarea",
                      "number",
                      "switch",
                      "slider",
                      "select",
                      "multiselect",
                      "color",
                      "file",
                      "directory",
                      "authorizedDirectory"
                    ]
                  },
                  "min": {
                    "type": ["number", "null"]
                  },
                  "max": {
                    "type": ["number", "null"]
                  },
                  "step": {
                    "type": ["number", "null"],
                    "exclusiveMinimum": 0
                  },
                  "unit": {
                    "type": ["string", "null"]
                  },
                  "options": {
                    "type": "array",
                    "maxItems": 128,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["label", "value"],
                      "properties": {
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "value": {}
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
