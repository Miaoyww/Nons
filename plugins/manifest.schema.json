{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nons:plugin:manifest:1",
  "title": "Nons Plugin Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "permissions", "engines"],
  "anyOf": [
    {
      "required": ["backend"],
      "properties": {
        "backend": {
          "type": "string"
        }
      }
    },
    {
      "required": ["frontend"],
      "properties": {
        "frontend": {
          "type": "string"
        }
      }
    }
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/id"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "description": "SemVer; checked by Rust semver."
    },
    "backend": {
      "type": ["string", "null"],
      "pattern": "\\.wasm$"
    },
    "frontend": {
      "type": ["string", "null"],
      "pattern": "\\.mjs$"
    },
    "configuration": {
      "type": ["string", "null"],
      "pattern": "\\.json$",
      "description": "包内配置声明路径，需要 config 权限。"
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "clipboard:music-links",
          "storage",
          "music:metadata",
          "player:read",
          "player:control",
          "ui",
          "config",
          "files:data",
          "files:selected",
          "clipboard:read",
          "http:request",
          "http:transfer",
          "secrets",
          "account:credentials"
        ]
      }
    },
    "engines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app", "pluginApi", "uiApi"],
      "properties": {
        "app": {
          "type": "string"
        },
        "pluginApi": {
          "type": "string"
        },
        "uiApi": {
          "type": "string"
        }
      }
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "views": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "slot", "export"],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "slot": {
                "const": "main.overlay"
              },
              "export": {
                "$ref": "#/$defs/export"
              }
            }
          }
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "path", "export"],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "path": {
                "type": "string",
                "pattern": "^/"
              },
              "export": {
                "$ref": "#/$defs/export"
              }
            }
          }
        },
        "navigation": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "page"],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "page": {
                "$ref": "#/$defs/id"
              }
            }
          }
        },
        "commands": {
          "type": "array"
        },
        "menus": {
          "type": "array"
        },
        "contextMenus": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "target", "source", "label", "export"],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "target": {
                "const": "song"
              },
              "source": {
                "enum": ["netease", "local"]
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "icon": {
                "$ref": "#/$defs/id",
                "description": "图标标识；当前支持 download、layout-grid，省略或未知标识使用 LayoutGrid。"
              },
              "export": {
                "$ref": "#/$defs/export"
              }
            }
          }
        },
        "settings": {
          "type": "array"
        },
        "shortcuts": {
          "type": "array"
        }
      }
    },
    "httpHosts": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 253
      },
      "description": "http:request/http:transfer 的域名范围；支持精确域名或 *（任意 DNS 域名，启用时显示敏感权限警告），不含协议、端口、IP 或子域通配符，由 Rust 校验。"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "export": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_]{1,128}$"
    }
  }
}
